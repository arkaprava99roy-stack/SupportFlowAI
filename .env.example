# =====================================================================
# SupportFlow AI — Environment Configuration
# =====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Database Configuration
# Local SQLite (Default offline fallback)
DATABASE_URL=sqlite:///./data/supportflow.db
# PostgreSQL (Production Docker Compose)
# DATABASE_URL=postgresql://supportflow:supportflow_pass@postgres:5432/supportflow_db

# Security & Authentication (JWT)
JWT_SECRET_KEY=supportflow_super_secret_jwt_key_2026_production_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & OpenAI Configuration (Optional - falls back to deterministic rule engine if omitted)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Observability & Distributed Tracing (Optional - falls back to local logs/traces.jsonl)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=SupportFlow-AI-Production
LANGSMITH_TRACING=true

# Guardrails & Safety
MAX_USER_ORDER_LIMIT=20
TWO_PHASE_CONFIRMATION_REQUIRED=true
